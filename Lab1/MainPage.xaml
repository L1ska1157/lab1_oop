<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lab1.ViewModels"
             x:Class="Lab1.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Електронні таблиці">
    <ContentPage.Resources>
        <x:Double x:Key="CellWidth">220</x:Double>
        <x:Double x:Key="CellHeight">70</x:Double>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Довідка" Command="{Binding ShowHelpCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="10" RowSpacing="8">

        <!-- Рядок 0: кнопки та режим -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <HorizontalStackLayout Grid.Column="0" Spacing="10">
                <Button Text="Видалити рядок" Command="{Binding DeleteRowCommand}" />
                <Button Text="Видалити стовпчик" Command="{Binding DeleteColCommand}" />
                <Button Text="Додати рядок" Command="{Binding AddRowCommand}" />
                <Button Text="Додати стовпчик" Command="{Binding AddColCommand}" />
                <Label Text="Редагування:" VerticalOptions="Center" />
                <Switch IsToggled="{Binding IsExpressionMode}" />
                <Button Text="Зберегти" Command="{Binding SaveCommand}" />
                <Button Text="Відкрити" Command="{Binding LoadCommand}" />
            </HorizontalStackLayout>

            <Button Grid.Column="1" Text="Вийти" Command="{Binding ExitCommand}" />
        </Grid>

        <!-- Рядок 1: поле вводу -->
        <HorizontalStackLayout Grid.Row="1" Spacing="10">
            <Entry Text="{Binding EditorText}"
                   IsEnabled="{Binding IsExpressionMode}"
                   ReturnType="Done"
                   ReturnCommand="{Binding CommitCommand}"
                   Placeholder="Вираз"
                   WidthRequest="400" />
            <Button Text="Застосувати" Command="{Binding CommitCommand}" />
        </HorizontalStackLayout>

        <!-- Рядок 2: таблиця -->
        <ScrollView Grid.Row="2" Orientation="Both">
            <VerticalStackLayout>

                <!-- Заголовки стовпчиків -->
                <HorizontalStackLayout>
                    <Label WidthRequest="40" />
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ColumnHeaders}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" WidthRequest="{StaticResource CellWidth}"
                                       HorizontalTextAlignment="Center" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <!-- Рядки -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:RowViewModel">
                            <HorizontalStackLayout>
                                <Label Text="{Binding Number}" WidthRequest="40"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center" />
                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Cells}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CellViewModel">
                                            <Border WidthRequest="{StaticResource CellWidth}" HeightRequest="{StaticResource CellHeight}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor"
                                                                Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Text}"
                                                       FontSize="14"
                                                       MaxLines="3"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalTextAlignment="Center"
                                                       Padding="6,0">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>